{
  "name": "tsdraft",
  "version": "0.4.0",
  "description": "2D CAD drawings as TypeScript: write the drawing in code, export DXF and SVG.",
  "keywords": [
    "2d",
    "autocad",
    "bricscad",
    "cad",
    "drafting",
    "drawing",
    "dxf",
    "svg",
    "typescript"
  ],
  "homepage": "https://github.com/Surfside-Software/tsdraft#readme",
  "bugs": {
    "url": "https://github.com/Surfside-Software/tsdraft/issues"
  },
  "license": "MIT",
  "author": "Stephen Frederick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Surfside-Software/tsdraft.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check": "tsc --noEmit",
    "check:tsrs": "tsrs --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test test/*.test.ts",
    "test:package": "node scripts/package-smoke.ts",
    "example": "node examples/site-plan.ts && node examples/outdoor-kitchen.ts",
    "readme:drawing": "node scripts/readme-drawing.ts",
    "verify": "pnpm fmt:check && pnpm lint && pnpm check && pnpm test && pnpm test:package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2"
}
